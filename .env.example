# 厉影AI 混剪 免费开源工具
# 环境变量参考；程序不会自动加载 .env 文件，请在终端设置环境变量。
# 纯本地 --local 无需 Key；云端按所选服务实际额度与计费规则执行。
# 可改成其他兼容服务地址。
VIDEOMIX_BASE_URL=https://api.openapi.cn/v1

# 在 https://api.openapi.cn 或所选兼容服务获取 Key；不要提交真实 Key。
VIDEOMIX_API_KEY=

# 模型
VIDEOMIX_CHAT_MODEL=deepseek-v4.1-flash
VIDEOMIX_TTS_MODEL=indextts2-v1

# 配音参考音频（3-10 秒清晰人声，本地路径或 URL）
VIDEOMIX_TTS_VOICE=
